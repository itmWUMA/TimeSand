# TimeSand Environment Configuration
# Copy this file to `.env` and fill in the values.
# `.env` is git-ignored; `.env.example` is committed as a template.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Initial admin password. Must be at least 8 characters.
# If unset, the system stays uninitialized and /api/auth/login returns 503.
TIMESAND_ADMIN_PASSWORD=changeme

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Root directory for database and media files.
# Defaults to ../data outside Docker, /data inside Docker.
# DATA_DIR=../data

# Comma-separated list of allowed CORS origins for the frontend dev server.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Backend log level: DEBUG, INFO, WARNING, ERROR, CRITICAL.
# LOG_LEVEL=INFO

# Backend log format: json or console.
# LOG_FORMAT=json

# Initial admin username. Used only when the user table is empty.
# TIMESAND_ADMIN_USERNAME=admin

# Whether to seed demo photos and music on first startup.
# Set to false or 0 to skip.
# ENABLE_DEMO_SEED=true
